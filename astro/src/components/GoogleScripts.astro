---
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? "G-SGM63ET6X1";
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT_ID ?? "ca-pub-6996931662051674";
---

<!-- Google Analytics 4: asynchronous loading, preserving the existing measurement ID. -->
<script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
<script is:inline define:vars={{ gaId }}>
  window.dataLayer = window.dataLayer || [];
  window.gtag = window.gtag || function gtag() { window.dataLayer.push(arguments); };
  window.gtag("js", new Date());
  window.gtag("config", gaId);
</script>

<!-- AdSense library is loaded asynchronously once through the shared site layout. -->
<script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`} crossorigin="anonymous"></script>
